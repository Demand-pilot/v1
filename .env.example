# DemandPilot Environment Configuration Template
# NOTE: Copy this file to .env and configure your secure credentials. Never commit secrets!

# Environment & Server
ENVIRONMENT=production
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Supabase Project Configuration (Server-Side Only)
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here
SUPABASE_JWT_SECRET=your_supabase_jwt_signing_secret_here

# Redis 7 Caching (Optional High-Speed Cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_TTL=86400

# Groq Grounded LLM Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Machine Learning & Forecast Parameters
DATA_DIR=data
FORECAST_HORIZON_DAYS=16
DEFAULT_SERVICE_LEVEL_Z=1.65
